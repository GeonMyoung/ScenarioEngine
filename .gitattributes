# Preserve legacy CP949/UTF-8 source and generated file bytes.
* -text
/.gitignore text eol=lf
/.gitattributes text eol=lf
/.vsconfig text eol=lf
/README.md text eol=lf
/AGENTS.md text eol=lf
/Directory.Build.props text eol=lf
/Directory.Build.targets text eol=lf
/dependencies.lock.json text eol=lf
/doc/*.md text eol=lf
/doc/*.json text eol=lf
/tools/*.ps1 text eol=crlf
/dependencies/artifacts/*.zip filter=lfs diff=lfs merge=lfs -text

