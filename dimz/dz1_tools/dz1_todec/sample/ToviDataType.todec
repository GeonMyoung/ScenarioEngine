	----------------------------------------
	-- TovisTypeEnumMemb
	----------------------------------------
	target TovisTypeEnumMemb
	{
		codec default public
		{
			sequence
			{
				simple order;
				simple name alter("Dz1StrA16UTF8");
				simple nullflag(8) value_opt;
			}
		}
	};

