	typedef native Dz1TdqDbIface from dz1_tdq_types;		// with api dump
	
	------------------------------------------------------------------------------------
	-- Database Scheme
	------------------------------------------------------------------------------------
	typedef struct Dz1TdqDbScheme
	{
		Dz1TdqDbConnArg				*arg;
		Dz1TdqDbIface				*dbh;					// is nodump, notarg
		
		Dz1TdqTblShapeList			*shapes;				// is notarg
		
		Dz1TdqTblInstanceList		*tables;				// is notarg
		Dz1TdqTblInstanceSeq		*tblseq;				// is notarg
		
