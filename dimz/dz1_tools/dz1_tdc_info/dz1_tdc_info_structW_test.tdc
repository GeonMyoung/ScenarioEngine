message set definition
{
	include libdz1_support;
	include dz1_asn1_support;
	-----------------------------------------------------------------
	-- W mode
	-----------------------------------------------------------------
	typedef struct MyDataEntryW
	{
		wstr						 name;				// is key
		uint32						 val;				// is key
	} MyDataEntryW;										// with windows api dumpW, fdumpW, clone, compare

	typedef unique table MyDataUniqueListW(find, extract, gethead, gettail) [MyDataEntryW];
	typedef unique table MyDataUniqueRefListW(find, extract, gethead, gettail) [&MyDataEntryW];

	typedef ordered table MyDataOrderedListW(find, extract, gethead, gettail) [MyDataEntryW];
	typedef ordered table MyDataOrderedRefListW(find, extract, gethead, gettail) [&MyDataEntryW];

	typedef table MyDataListW(find, extract, gethead, gettail) [MyDataEntryW];
	typedef table MyDataRefListW(find, extract, gethead, gettail) [&MyDataEntryW];

	typedef unique array MyDataUniqueArrayW(find, extract, gethead, gettail) [MyDataEntryW];
	typedef unique array MyDataUniqueRefArrayW(find, extract, gethead, gettail) [&MyDataEntryW];

	typedef ordered array MyDataOrderedArrayW(find, extract, gethead, gettail) [MyDataEntryW];
	typedef ordered array MyDataOrderedRefArrayW(find, extract, gethead, gettail) [&MyDataEntryW];

	typedef array MyDataArrayW(find, extract, gethead, gettail) [MyDataEntryW];
	typedef array MyDataRefArrayW(find, extract, gethead, gettail) [&MyDataEntryW];

	typedef index MyDataIndexW [MyDataEntryW(val)];
	typedef index MyDataRefIndexW [&MyDataEntryW(val)];

	typedef struct ArrayMemberTypeW
	{
		MyDataEntryW				*obj_ptr_arr[obj_ptr_cnt];
		uint32						 obj_ptr_cnt;

		MyDataEntryW				 obj_arr[obj_cnt];
		uint32						 obj_cnt;

		uint64						 prims_arr[prims_cnt];
		uint32						 prims_cnt;

		uint64						*primptrs_arr[primptrs_cnt];
		uint32						 primptrs_cnt;

		wstr						 str_arr[str_cnt];
		uint32						 str_cnt;

		int32						*i_val;				// is ref
	} ArrayMemberTypeW;									// with windows api dumpW, fdumpW, clone
}
