MyBool ::= BOOLEAN

--*********************************************************************
-- INTEGER(2)
--*********************************************************************
MyInt0 ::= INTEGER {
	spec-RevocableLane			(0),
	spec-commuterRailRoadTrack	(1), 
	spec-lightRailRoadTrack		(2),
	spec-heavyRailRoadTrack		(3),
	spec-otherRailType			(4)
} (0..10|100..1000|10000..20000)

MyInt1 ::= [ APPLICATION 21 ] INTEGER(301..10000)
MyInt2 ::= [ APPLICATION 22 ] EXPLICIT INTEGER(101..200)
MyInt3 ::= [ APPLICATION 23 ] IMPLICIT INTEGER(201..300)
MyInt4 ::= [ APPLICATION 24 ] MyInt0
MyInt5 ::= [ APPLICATION 25 ] EXPLICIT MyInt0
MyInt6 ::= [ APPLICATION 26 ] IMPLICIT MyInt0

