message set definition
{
	include Dz1TcpCallbackClientDef;
	-- typedef native Dz1SocketBuf from dz1_socket_buf;
	-- typedef native Dz1SocketFifo from dz1_socket_fifo;	

	typedef enum Dz1TcpCallbackSessionLife
	{
		immediateDie,
		negotiationAndDie,
		sendAndDie,
		tenSecond,
		halfHour,
		immotal0,
		immotal1,
		immotal2,
		immotal3,
		immotal4,
		immotal5
	} Dz1TcpCallbackSessionLife;
	
	typedef struct Dz1TcpCallbackSession
	{
		Dz1SockAddr					*peer;			// is key	-- address, port
		Dz1SockAddr					*local;			// is key
		Dz1TcpClientSocket			*sock;
		Dz1SocketBuf				*rx_buf;
		Dz1SocketFifo				*tx_fifo;
