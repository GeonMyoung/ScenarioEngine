	} Dz1TcpCallbackSession;						// with api dump, compare
	typedef unique table Dz1TcpCallbackSessionList(find, extract, count, gethead) [Dz1TcpCallbackSession];

	typedef struct Dz1TcpCallbackClientCmd
	{
		Dz1SockAddr					*server_addr;
		uint32						 max_conn;
		bool						 use_ssl;
		bool						 stress_mode;
	} Dz1TcpCallbackClientCmd;						// with api dump, clone
	
	typedef struct Dz1TcpCallbackClientEnv
	{
		void						*tSelf;
		Dz1TcpCallbackSessionList	*sessions;		// is notarg
