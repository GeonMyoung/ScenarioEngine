Circle ::= SEQUENCE {
   center   Position3D,
   radius   Radius-B12, 
   units    DistanceUnits
   }

ExitService ::= SEQUENCE (SIZE(1..16)) OF SEQUENCE {     -- j2735 표준 syntax error
