   junction                            ITISCodes-KOR ::= 13378 -- 합류도로 알림 
   ahead                               ITISCodes-KOR ::= 13569 -- (교차로) 직진 상충 
   left-turn                           ITISCodes-KOR ::= 13594 -- 좌회전 
   right-turn                          ITISCodes-KOR ::= 13599 -- 우회전 

ResponseType-KOR ::= ENUMERATED {
   not-in-use                 (0),
   emergency                  (1),
   non-emergency              (2),
   emergency-in-drill         (3),
   emergency-pursuit          (4),
   emergency-stationary       (5),
   emergency-slow-moving      (6),
   emergency-stop-go          (7),
   ...
}

VehicleEventFlags-KOR ::= BIT STRING {
   airbagOpening              (0),
   tireAirePressureError      (1),
   batteryDischarge           (2),
   highTemperature            (3),
   exteriorLightsAbnormal     (4),
   otherEvents                (5),
   wiperChange                (6),
   reserved                   (7)
} (SIZE(8))
VerticalHeading-KOR ::= INTEGER (-101..100)

EventOrSvcInfo-KOR ::= SEQUENCE {
   typeEvent            ITISCodes-KOR        OPTIONAL,
   description          ITIScodesAndText     OPTIONAL,
   text                 SEQUENCE (SIZE(1..8)) OF UTF8String   OPTIONAL,
   subtext              SEQUENCE (SIZE(1..8)) OF UTF8String   OPTIONAL,
   ...
}

FuelEfficiency-KOR ::= SEQUENCE {
   vehicleMileage       INTEGER     OPTIONAL,
   evMileage            INTEGER     OPTIONAL,
   ...
}

FuelResidualQuantity-KOR ::= SEQUENCE {
   vehiclePercent       INTEGER (0..100)  OPTIONAL,
   evPercent            INTEGER (0..100)  OPTIONAL,
   ...
}

FuelStatus-KOR ::= SEQUENCE {
   efficiency           FuelEfficiency-KOR         OPTIONAL,
   residualQuantity     FuelResidualQuantity-KOR   OPTIONAL,
   tankCapacity         FuelTankCapacity-KOR       OPTIONAL,
   ...
}

FuelTankCapacity-KOR ::= SEQUENCE {
   fuelCapacity         INTEGER (0..255)     OPTIONAL,
   evCapacity           INTEGER (0..255)     OPTIONAL,
   ...
}

GyroscopeValue-KOR ::= SEQUENCE {
   xmax     INTEGER (-32767..32767) OPTIONAL,
   xmin     INTEGER (-32767..32767) OPTIONAL,
   xavg     INTEGER (-32767..32767) OPTIONAL,
   ymax     INTEGER (-32767..32767) OPTIONAL,
   ymin     INTEGER (-32767..32767) OPTIONAL,
   yavg     INTEGER (-32767..32767) OPTIONAL,
   zmax     INTEGER (-32767..32767) OPTIONAL,
   zmin     INTEGER (-32767..32767) OPTIONAL,
   zavg     INTEGER (-32767..32767) OPTIONAL,
   ...
}

MsgLog-KOR ::= SEQUENCE {
   furtherInfoID           FurtherInfoID,
   msgType                 MsgType-KOR,
   msgEvent                ITISCodes-KOR           OPTIONAL,
   msgID                   TemporaryID,
   msgDate                 DDateTime               OPTIONAL,
   msgCommType             MsgCommType-KOR         OPTIONAL,
   msgChannel              MsgChannel-KOR          OPTIONAL,
   msgDeviceType           MsgDeviceType-KOR,
   msgDisplayLocation      MsgDisplayLocation-KOR  OPTIONAL,
   msgDisplayTime          DDateTime               OPTIONAL,
   ...
}

MsgLogs-KOR ::= SEQUENCE {
   rcvMsgs     SEQUENCE (SIZE(1..20)) OF MsgLog-KOR   OPTIONAL,
   sndMsgs     SEQUENCE (SIZE(1..30)) OF MsgLog-KOR   OPTIONAL,
   ...
}

ProbeVehicleData-KOR ::= SEQUENCE {
   msgID                INTEGER (0..65535),
   curlane              DectLane-KOR,
   driverStatus         HumanDriverStatus-KOR         OPTIONAL,
   deviceStatus         DeviceStatus-KOR              OPTIONAL,
   transitStatus        TransitVehicleStatus          OPTIONAL,
   transitOccupancy     TransitVehicleOccupancy       OPTIONAL,
   roadWorkInfo         RoadWorkInfo-KOR              OPTIONAL,
   eventOrSvcInfo       EventOrSvcInfo-KOR            OPTIONAL,
   msgLogs              MsgLogs-KOR                   OPTIONAL,   
   vehicleControlInfo   VehicleControlInfo-KOR        OPTIONAL,
   drivingStatus        DrivingStatus-KOR             OPTIONAL,
   fuelStatus           FuelStatus-KOR                OPTIONAL,
   sensorValues         SensorValuesRegardingDriving-KOR OPTIONAL,
   ...
}

RoadWorkInfo-KOR ::= SEQUENCE {
   worklanes         SEQUENCE (SIZE(1..16)) OF LaneID OPTIONAL,
   workstart         DDateTime   OPTIONAL,
   workend           DDateTime   OPTIONAL,
   ...
}

SensorValuesRegardingDriving-KOR ::= SEQUENCE {
   rpm         Rpm-KOR              OPTIONAL,
   gears       TransmissionState    OPTIONAL,
   gyro        GyroscopeValue-KOR   OPTIONAL,
   ...
}

VehicleControlInfo-KOR ::= SEQUENCE {
   mode           VehicleControlMode-KOR     OPTIONAL,
   tunring        PossibleTurn-KOR           OPTIONAL,
   angle          DrivingWheelAngle          OPTIONAL,
   ...
}

DeviceStatus-KOR ::= BIT STRING {
   noADASignal       (0),
   noDrowsySignal    (1),
   noV2XSignal       (2),
   noDisplaySignal   (3),
   noDTGSignal       (4),
   noGPSignal        (5),
   noCITSCenterCon   (6),
   noHMIstate        (7)
} (SIZE(8))

DrivingStatus-KOR ::= ENUMERATED {
   stop              (0),
   forward-moving    (1),
   backward-moving   (2),
   straight          (3),
   left-turning      (4),
   right-turning     (5),
   parking           (6),
   ...
}
HumanDriverStatus-KOR ::= ENUMERATED {
   frontEyeOut       (0),
   drowsyLight       (1),
   drowsySerious     (2),
   faceOut           (3),
   smoking           (4),
   phone             (5),
   yawn              (6),
   ...
}
MsgChannel-KOR ::= INTEGER (0..65535)
MsgCommType-KOR ::= ENUMERATED {
   unavailable       (0),
   wave              (1),
   lte               (2),
   g5                (3),
   ...
}
MsgDeviceType-KOR ::= ENUMERATED {
   other              (0),
   communication      (1),
   display            (2),
   adas               (3),
   drowsinessDetector (4),
   ...
}
MsgDisplayLocation-KOR ::= INTEGER (0..128)
   entry                MsgDisplayLocation-KOR ::= 0     -- 사전 설정 구간 진입
   beforeEntry          MsgDisplayLocation-KOR ::= 1     -- 사전 설정 구간 진입 전
   timIn                MsgDisplayLocation-KOR ::= 2     -- TIM 구간 진입 지점  <- 여기부터 ASN.1 syntax 확인 필요
   timOut               MsgDisplayLocation-KOR ::= 3     -- TIM 구간 해제 지점
   ttcZone0             MsgDisplayLocation-KOR ::= 4     -- TTC 구간 0 지점
   ttcZone1             MsgDisplayLocation-KOR ::= 5     -- TTC 구간 1 지점
   ttcZone2             MsgDisplayLocation-KOR ::= 6     -- TTC 구간 2 지점
   ttcZone3             MsgDisplayLocation-KOR ::= 7     -- TTC 구간 3 지점
   alertZone            MsgDisplayLocation-KOR ::= 8     -- 경고 구간
   v2vPreapproachZone0  MsgDisplayLocation-KOR ::= 9     --
   v2vApproachZone0     MsgDisplayLocation-KOR ::= 10    --
   v2vApproachZone1     MsgDisplayLocation-KOR ::= 11    --
   others               MsgDisplayLocation-KOR ::= 12    --

MsgType-KOR ::= ENUMERATED {
   bsm               (0),
   spat              (1),
   tls               (2),
   map               (3),
   nmeacorrections   (4),
   rtcmcorrections   (5),
   pvd               (6),
   pdm               (7),
   rsa               (8),
   tim               (9),
   adas              (10),
   psm               (11),
   drowsiness         (12),
   ...
}

PossibleTurn-KOR ::= ENUMERATED {
   non            (0),
   left-turn      (1),
   right-turn     (2),
   both-turn      (3),
   ...
}
Rpm-KOR ::= INTEGER (0..10000)
VehicleControlMode-KOR ::= ENUMERATED {
   manual   (0),
   auto     (1),
   ...
}

DetectedObject-KOR ::= SEQUENCE {
   objectID          OCTET STRING (SIZE(1..64)),
   objectType        ITIScodes      OPTIONAL,
   objectLocation    FullPositionVector,
   ...
}

DetectedObjectInfo-KOR ::= SEQUENCE {
   detectorID        UTF8String (SIZE(1..128)),
   objects           DetectedObjectList-KOR,
   ...
}
DetectedObjectList-KOR ::= SEQUENCE (SIZE(1..32)) OF DetectedObject-KOR

GeographicalPath-KOR ::= SEQUENCE {
   regions        SEQUENCE (SIZE(1..32)) OF RegionDescribedByID-KOR,
   ...
}

ParkingCapacity-KOR ::= SEQUENCE {
   type                    ParkingType-KOR,
   numberOfParkingSpace    INTEGER,
   maxParkingSpace         INTEGER OPTIONAL,
   ...
}

ParkingZoneInformation-KOR ::= SEQUENCE {
   name        UTF8String (SIZE(1..128))  OPTIONAL,
   id          UTF8String (SIZE(1..128)) OPTIONAL,
   capacity    SEQUENCE (SIZE(0..16)) OF ParkingCapacity-KOR,
   ...
}

RegionDescribedByID-KOR ::= CHOICE {
   laneID            LaneID,
   segmentID         RoadSegmentID,
   linkID            UTF8String (SIZE(1..128)),
   detectLane        DectLane-KOR,
   areaID            UTF8String (SIZE(1..128)),
   intersections     IntersectionID,
   ...
}

RidingNotification-KOR ::= SEQUENCE {
   stopID            UTF8String (SIZE(1..128))        OPTIONAL,
   disabled          Disabled-KOR      OPTIONAL,
   boarding          BOOLEAN           OPTIONAL,
   ...
}

RoadSideAlert-KOR ::= SEQUENCE {
   msgID             INTEGER (0..65535)            OPTIONAL,
   regions           SEQUENCE OF RegionDescribedByID-KOR OPTIONAL,
   events            EventOrSvcInfo-KOR            OPTIONAL,
   state             MovementEvent                 OPTIONAL,
   detectedObject    DetectedObjectInfo-KOR        OPTIONAL,
   ...
}

ServiceAreaInformation-KOR ::= SEQUENCE {
   name              UTF8String (SIZE(1..128)),
   id                UTF8String (SIZE(1..128)),
   direction         HighwayDirection-KOR,
   stationInfo       SEQUENCE (SIZE(0..8)) OF StationInformation-KOR    OPTIONAL,
   parkingInfo       SEQUENCE (SIZE(0..8)) OF ParkingZoneInformation-KOR OPTIONAL,
   ...
}

StationInformation-KOR ::= SEQUENCE {
   type           FuelType-KOR,
   capacity       INTEGER (0..256)  OPTIONAL,
   maxcapacity    INTEGER (0..256)  OPTIONAL,
   price          INTEGER           OPTIONAL,
   ...
}

TollgateLane-KOR ::= SEQUENCE {
   laneNo         DectLane-KOR      OPTIONAL,
   linkID         LaneID            OPTIONAL,
   type           TollgateType-KOR  OPTIONAL,
   open           BOOLEAN           OPTIONAL,
   ...
}

TollgateLaneInformation-KOR ::= SEQUENCE {
   name           UTF8String (SIZE(1..128))  OPTIONAL,
   heading        HighwayDirection-KOR       OPTIONAL,
   lanes          SEQUENCE (SIZE(0..32)) OF TollgateLane-KOR   OPTIONAL,
   ...
}

TravelerDataFrameAdditionalInformation-KOR ::= SEQUENCE {
   dataFrameIndex             INTEGER (0..8),
   events                     EventOrSvcInfo-KOR            OPTIONAL,
   vehicleRidingStatus        RidingNotification-KOR        OPTIONAL,
   weatherInfo                WeatherInfo-KOR               OPTIONAL,
   serviceArea                ServiceAreaInformation-KOR    OPTIONAL,
   tollgate                   TollgateLaneInformation-KOR   OPTIONAL,
   ...
}

TravelerInformation-KOR ::= SEQUENCE {
   msgID          INTEGER        OPTIONAL,
   additionalInfo SEQUENCE (SIZE(1..8)) OF TravelerDataFrameAdditionalInformation-KOR OPTIONAL,
   ...
}

WeatherInfo-KOR ::= SEQUENCE {
   temp           AmbientAirTemperature         OPTIONAL,
   rainfall       EssPrecipRate                 OPTIONAL,
   humidity       INTEGER (0..100)              OPTIONAL,
   windDir        HeadingSlice                  OPTIONAL,
   windSpd        INTEGER (0..10000)            OPTIONAL,
   ...
}

Disabled-KOR ::= BOOLEAN
FuelType-KOR ::= ENUMERATED {
   gasoline       (0),
   diesel         (1),
   lpg            (2),
   premium        (3),
   hydrogen       (4),
   normalCharging (5),
   quickCharging  (6),
   superCharging  (7),
   ...
}
HighwayDirection-KOR ::= ENUMERATED {
   up          (0),
   down        (1),
   upAndDown   (2),
   ...
}

ParkingType-KOR ::= ENUMERATED {
   normal      (0),
   disable     (1),
   big         (2),
   compact     (3),
   emergency   (4),
   women       (5),
   etc         (6),
   ...
}

TollgateType-KOR ::= ENUMERATED {
   general           (1),
   hipass            (2),
   truck-hipass      (3),
   multi-hipass-2    (4),
   multi-hipass-3    (5),
   multi-hipass-4    (6),
   multi-hipass-5    (7),
   multi-hipass-6    (8),
   multi-hipass-7    (9),
   multi-hipass-8    (10),
   multi-hipass-9    (11),
   multi-hipass-10   (12),
   ...
}




-- SDSM
DetectedObjectList ::= SEQUENCE (SIZE(1..256)) OF DetectedObjectData

DetectedObjectData::= SEQUENCE {
    detObjCommon    DetectedObjectCommonData,
    -- Common data for detected object
    detObjOptData   DetectedObjectOptionalData OPTIONAL
    -- Type specific optional data
}

DetectedObjectCommonData::= SEQUENCE {
    objType             ObjectType,
    objTypeCfd          ClassificationConfidence,
    objectID            ObjectID,
    -- temporary ID assigned by source
    measurementTime     MeasurementTimeOffset,
    -- Detection time
    timeConfidence      TimeConfidence,
    pos                 PositionOffsetXYZ,
    posConfidence       PositionConfidenceSet,
    speed               Speed,
    speedConfidence     SpeedConfidence,
    speedZ              Speed OPTIONAL,
    speedConfidenceZ    SpeedConfidence OPTIONAL,
    heading             Heading,
    headingConf         HeadingConfidence,
    accel4way           AccelerationSet4Way OPTIONAL,
    accCfdX             AccelerationConfidence OPTIONAL,
    accCfdY             AccelerationConfidence OPTIONAL,
    accCfdZ             AccelerationConfidence OPTIONAL,
    accCfdYaw           YawRateConfidence OPTIONAL,
    ...
}



DetectedObjectOptionalData ::= CHOICE {
    detVeh      DetectedVehicleData,
    -- Detected vehicle data
    detVRU      DetectedVRUData,
    -- Detected VRU data
    detObst     DetectedObstacleData
    -- Detected obstacle data
}

DetectedVehicleData::= SEQUENCE {
    lights                  ExteriorLights              OPTIONAL,
    vehAttitude             Attitude                    OPTIONAL,
    vehAttitudeConfidence   AttitudeConfidence          OPTIONAL,
    vehAngVel               AngularVelocity             OPTIONAL,
    vehAngVelConfidence     AngularVelocityConfidence   OPTIONAL,
    size                    VehicleSize                 OPTIONAL,
    height                  VehicleHeight               OPTIONAL,
    vehicleSizeConfidence   VehicleSizeConfidence       OPTIONAL,
    vehicleClass            BasicVehicleClass           OPTIONAL,
    classConf               ClassificationConfidence    OPTIONAL,
    ...
}

Attitude ::= SEQUENCE {
    pitch   PitchDetected,
    roll    RollDetected,
    yaw     YawDetected
}

AttitudeConfidence ::= SEQUENCE {
    pitchConfidence     HeadingConfidence,
    rollConfidence      HeadingConfidence,
    yawConfidence       HeadingConfidence
}

AngularVelocity ::= SEQUENCE {
    pitchRate   PitchRate,
    rollRate    RollRate
}

AngularVelocityConfidence ::= SEQUENCE {
    pitchRateConfidence PitchRateConfidence OPTIONAL,
    rollRateConfidence RollRateConfidence OPTIONAL
}

VehicleSizeConfidence ::= SEQUENCE {
    vehicleWidthConfidence      SizeValueConfidence,
    vehicleLengthConfidence     SizeValueConfidence,
    vehicleHeightConfidence     SizeValueConfidence OPTIONAL
}

DetectedVRUData::= SEQUENCE {
    basicType       PersonalDeviceUserType  OPTIONAL,
    propulsion      PropelledInformation    OPTIONAL,
    attachment      Attachment              OPTIONAL,
    radius          AttachmentRadius        OPTIONAL
}

DetectedObstacleData::= SEQUENCE {
    obstSize            ObstacleSize,
    obstSizeConfidence  ObstacleSizeConfidence
}

ObstacleSize ::= SEQUENCE {
    width   SizeValue,
    length  SizeValue,
    height  SizeValue   OPTIONAL
}

ObstacleSizeConfidence ::= SEQUENCE {
    widthConfidence     SizeValueConfidence,
    lengthConfidence    SizeValueConfidence,
    heightConfidence    SizeValueConfidence     OPTIONAL
}

PositionOffsetXYZ ::= SEQUENCE {
    offsetX     ObjectDistance,
    offsetY     ObjectDistance,
    offsetZ     ObjectDistance OPTIONAL
}

ObjectDistance ::=INTEGER(-32767..32767) --LSB units of 0.1 meters

ObjectType::= ENUMERATED{
    unknown (0),
    vehicle (1),
    vru     (2),
    animal  (3),
    ...
}
ClassificationConfidence ::= INTEGER (0..101)

ObjectID ::= INTEGER (0..65535)

MeasurementTimeOffset ::= INTEGER (-1500..1500) -- LSB units of 1ms

PitchDetected ::= INTEGER (-7200..7200)
    -- LSB units of 0.0125 degrees (signed)
    -- range of -90 to 90 degrees

RollDetected ::= INTEGER (-14400..14400)
    -- LSB units of 0.0125 degrees (signed)
    -- range of -180 to 180 degrees

YawDetected ::= INTEGER (-14400..14400)
    -- LSB units of 0.0125 degrees (signed)
    -- range of -180 to 180 degrees

PitchRate ::= INTEGER (-32767..32767)
    -- LSB units of 0.01 degrees per second (signed)
    -- unavailable (32767)

RollRate ::= INTEGER (-32767..32767)
    -- LSB units of 0.01 degrees per second (signed)
    -- unavailable (32767)

PitchRateConfidence ::= ENUMERATED {
    unavailable (0), -- B'000 Not Equipped with angular velocity status
    -- or angular velocity status is unavailable
    degSec-100-00 (1), -- B'001 100 deg/sec
    degSec-010-00 (2), -- B'010 10 deg/sec
    degSec-005-00 (3), -- B'011 5 deg/sec
    degSec-001-00 (4), -- B'100 1 deg/sec
    degSec-000-10 (5), -- B'101 0.1 deg/sec
    degSec-000-05 (6), -- B'110 0.05 deg/sec
    degSec-000-01 (7)  -- B'111 0.01 deg/sec
}

RollRateConfidence ::= ENUMERATED {
    unavailable (0), -- B'000 Not Equipped with angular velocity status
    -- or angular velocity status is unavailable
    degSec-100-00 (1), -- B'001 100 deg/sec
    degSec-010-00 (2), -- B'010 10 deg/sec
    degSec-005-00 (3), -- B'011 5 deg/sec
    degSec-001-00 (4), -- B'100 1 deg/sec
    degSec-000-10 (5), -- B'101 0.1 deg/sec
    degSec-000-05 (6), -- B'110 0.05 deg/sec
    degSec-000-01 (7)  -- B'111 0.01 deg/sec
}

SizeValueConfidence ::= ENUMERATED {
    unavailable (0),
    size-100-00 (1),    -- (100 m)
    size-050-00 (2),    -- (50 m)
    size-020-00 (3),    -- (20 m)
    size-010-00 (4),    -- (10 m)
    size-005-00 (5),    -- (5 m)
    size-002-00 (6),    -- (2 m)
    size-001-00 (7),    -- (1 m)
    size-000-50 (8),    -- (50 cm)
    size-000-20 (9),    -- (20 cm)
    size-000-10 (10),   -- (10 cm)
    size-000-05 (11),   -- (5 cm)
    size-000-02 (12),   -- (2 cm)
    size-000-01 (13)    -- (1 cm)
}

EquipmentType ::= ENUMERATED{
    unknown (0),
    rsu     (1),
    obu     (2),
    vru     (3),
    ...
}

SizeValue ::= INTEGER (0..1023) -- LSB units are 10 cm with a range of >100 meters

-- MSG
SensorDataSharingMessage ::= SEQUENCE {
    msgCnt              MsgCount,
    sourceID            TemporaryID,
    equipmentType       EquipmentType,
    sDSMTimeStamp       DDateTime,
    refPos              Position3D,
    refPosXYConf        PositionalAccuracy,
    refPosElConf        ElevationConfidence     OPTIONAL,
    objects             DetectedObjectList
}



-- TLS UT

TrafficLightStatusMessage ::= SEQUENCE {
  traffiLightID       TrafficLightID-KOR,
  lon                Longitude            OPTIONAL,
  lat                 Latitude 		         OPTIONAL,
  operationStatus     TrafficLightOperationStatus-KOR,
  controllerStatus    TrafficLightControllerStatus-KOR,
  cycleCounter        TimeInSecond-B16-KOR,
  cycleTime     	    TimeInSecond-B16-KOR,
  currentTime         DDateTime,
  trafficLightStatus  TrafficLightStatusList-KOR,
  ...
}
TrafficLightID-KOR ::= INTEGER(0..4294967295)
TrafficLightOperationStatus-KOR ::= BIT STRING {
  manual 		  	(0),
  flashing 		  (1),
  off 			  	(2),
  actuted 		  (3),
  transition 	  (4),
  priority 		  (5),
  holding-phase (6),
  reserved 		  (7)
} (SIZE(8))
TrafficLightControllerStatus-KOR ::= BIT STRING {
  conflict 			  (0),
  center-comm-error   (1),
  scu-comm-error	  (2),
  reserved1			  (3),
  reserved2			  (4),
  reserved3			  (5),
  reserved4			  (6),
  reserved5           (7)
} (SIZE(8))


TrafficLightStatusList-KOR ::= SEQUENCE (SIZE(1..255)) OF TrafficLightStatus-KOR
TrafficLightStatus-KOR ::= SEQUENCE {
  trafficLightType		      TrafficLightType-KOR,
  consecutiveTrafficLight   ConsecutiveTrafficLight-KOR,
  trafficLightIntervalType	TrafficLightIntervalType-KOR,
  pedestrianCall		        PedestrianCall-KOR,
  actuatedinterval		      ActuatedInterval-KOR,
  permissiveNonProtected	  PermissiveNonProtected-KOR,
  lightingStatus		        TrafficLightingStatus-KOR,
  maxIntervalLength		      TimeInSecond-B8-KOR,
  remainingTime		          TimeInSecond-B8-KOR,
  directionCode		          TrafficLightDirectionCode-KOR,
  reserved			            ReservedBit-KOR,
  ...
}
TrafficLightType-KOR ::= INTEGER(0..15)
ConsecutiveTrafficLight-KOR ::= INTEGER(0..15)
TrafficLightIntervalType-KOR ::= ENUMERATED {
  static   (0),
  variable (1),
  ...
}
PedestrianCall-KOR ::= BOOLEAN
ActuatedInterval-KOR ::= BOOLEAN
PermissiveNonProtected-KOR ::= BOOLEAN
TrafficLightingStatus-KOR ::= INTEGER(0..10)
TimeInSecond-B16-KOR ::= INTEGER (0..65535)

TimeInSecond-B8-KOR ::= INTEGER (0..255)
TrafficLightDirectionCode-KOR ::= INTEGER(10..89)
ReservedBit-KOR ::= BOOLEAN


-- 00100-3
IncidentDetectionInfo-incident-Detected-Type ::= ENUMERATED {
   stalledVehicle (1),
   reverseDriving (2),
   pedestrian (3),
   roadwayDebris (4),
   rireSmoke (5),
   roadShouldersVehicle (6),
   roadkill (7),
   slowVehicle (8),
   delayCongested (9)
}

NMEACoord-compass ::= ENUMERATED {
   north,
   south
}

NMEACoord-latitude ::= SEQUENCE {
   integerValue         INTEGER,
   fractionValue        INTEGER,
   fracSize             INTEGER (0..10),
   compass              NMEACoord-compass
}
NMEACoord-longitude ::= SEQUENCE {
   integerValue         INTEGER,
   fractionValue        INTEGER,
   fracSize             INTEGER (0..10),
   compass              NMEACoord-compass
}
NMEACoord ::= SEQUENCE {
   latitude                NMEACoord-latitude,
   longitude               NMEACoord-longitude,
   optData                 OCTET STRING         OPTIONAL
}

-- 돌발상황검지
IncidentDetectionInfo ::= SEQUENCE  {     
   incident-Detected-Time              VisibleString,
   incident-Detected-Type              IncidentDetectionInfo-incident-Detected-Type,
   incident-Detected-Site              NMEACoord,
   detected-Object-Size                INTEGER (0..255)     OPTIONAL,
   detected-Object-Distance            INTEGER (0..1000),
   detected-Object-Angle               INTEGER (0..360),
   detected-Object-Speed               INTEGER (0..300)
}

IncidentTerminationInfo-terminate-incidentType ::= ENUMERATED {
   termination (1),
   timeout (2)
}

-- 돌발상황해지정보
IncidentTerminationInfo ::= SEQUENCE {    
   terminate-incidentType        IncidentTerminationInfo-terminate-incidentType
}

IncidentDetectionVideoFileInfoProvide-fileStatus ::= ENUMERATED {
   videoFileExists (0),
   videoFileAlreadyExists (1)
}

-- 돌발상황검지영상정보
IncidentDetectionVideoFileInfoProvide ::= SEQUENCE {
   fileStatus                 IncidentDetectionVideoFileInfoProvide-fileStatus,
   fileName                   OCTET STRING (SIZE(1..30))       OPTIONAL,
   fileSize                   INTEGER                          OPTIONAL
}

-- 제어부 상태정보
ControlStateInfo ::= SEQUENCE {
   cpu         INTEGER (1..100),
   ram         INTEGER (1..100),
   disk        INTEGER (1..100)
}

SensorStateInfo-state ::= ENUMERATED {
   normal (0),
   abnormal (1)
}

-- 센서부 상태정보
SensorStateInfo ::= SEQUENCE {
   msm               SensorStateInfo-state,
   txb               SensorStateInfo-state,
   rxb               SensorStateInfo-state,
   pwr               SensorStateInfo-state
}

Novelty ::= ENUMERATED {
   noveltyNew (0),
   noveltyUpdate (1)
}

MovingObject-objectType ::= ENUMERATED {
   pedestrian (0),
   vehicle (1),
   bike (2)
}

-- 이동체 검지기 정보 원시 데이터 프레임
MovingObject ::= SEQUENCE {
   objectType        MovingObject-objectType,
   objectID          ObjectID,
   novelty           Novelty     OPTIONAL,
   reliability       INTEGER (0..100),
   fullPositionVector FullPositionVector
}

IncidentDetectionInfoResponse ::= SEQUENCE OF IncidentDetectionInfo
IncidentTerminationInfoResponse ::= SEQUENCE OF IncidentTerminationInfo
IncidentDetectionVideoFileInfoProvideResponse ::= SEQUENCE OF IncidentDetectionVideoFileInfoProvide
ControlStateInfoResponse ::= SEQUENCE OF ControlStateInfo
SensorStateInfoResponse ::= SEQUENCE OF SensorStateInfo
MovingObjectResponse ::= SEQUENCE OF MovingObject

END

