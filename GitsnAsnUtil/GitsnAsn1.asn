}

BrakePedalCmd-KOR ::= ENUMERATED {
   off   (0),
   on    (1)
}
BrakePedalPressure-KOR ::= INTEGER (0..101)
DectLane-KOR ::= ENUMERATED {
   unavailable             (0),
   busOnlyLane             (10),
   ctrBusLane              (11),
   rdSdBusLane             (12),
   mergingLane             (13),
   accelerationLane        (14),
   decelrationLane         (15),        -- deceleration 오타
   rampLane                (16),
   shoulderLane            (17),
   carLane                 (20),
   car-1stLane             (21),
   car-2ndLane             (22),
   car-3rdLane             (23),
   car-4thLane             (24),
   car-5thLane             (25),
   car-6thLane             (26),
   car-7thLane             (27),
   car-8thLane             (28),
   car-9thLane             (29),
   car-10thLane            (30),
   car-11thLane            (31),
   car-12thLane            (32),
   car-13thLane            (33),
   car-14thLane            (34),
   car-15thLane            (35),
   car-16thLane            (36),
   car-17thLane            (37),
   car-18thLane            (38),
   car-19thLane            (39),
   car-20thLane            (40),
   etcLane                 (99),
   ...
}

ITISCodes-KOR ::= INTEGER (0..65535)
   weather-conditions                  ITISCodes-KOR ::=    18  -- 기상정보 
   stop-and-go-traffic                 ITISCodes-KOR ::=   258  -- 정체, 지정체 알림 
   long-queues                         ITISCodes-KOR ::=   262  -- (교차로) 꼬리물기 
   speed-limit                         ITISCodes-KOR ::=   268  -- 램프 제한속력 알림 
   accident                            ITISCodes-KOR ::=   513  -- 사고, 대형사고 
   disabled-vehicle                    ITISCodes-KOR ::=   534  -- 정지, 정지차, 정지차량 알림 
   vehicle-on-fire                     ITISCodes-KOR ::=   540  -- 차량 화재 
   accident-cleared                    ITISCodes-KOR ::=   638  -- 교통사고 해제 
   incident-cleared                    ITISCodes-KOR ::=   639  -- 정지차량/화재 해제 
   closed-to-traffic                   ITISCodes-KOR ::=   769  -- 도로통제, 차로차단,교통통제 
   road-construction                   ITISCodes-KOR ::=  1025  -- 도로작업 
   road-maintenance-cleared            ITISCodes-KOR ::=  1036  -- 공사,청소,제설,관리해제, 도로유지보수 
   obstruction-on-roadway              ITISCodes-KOR ::=  1281  -- 낙하물 
   people-on-roadway                   ITISCodes-KOR ::=  1286  -- 도로상 보행자, 보행자 
   pothole                             ITISCodes-KOR ::=  1300  -- 포트홀 
   flooding                            ITISCodes-KOR ::=  1301  -- 홍수 
   landslide                           ITISCodes-KOR ::=  1310  -- 산사태 
   clearance-work                      ITISCodes-KOR ::=  1406  -- 공사 해제 
   obstruction-cleared                 ITISCodes-KOR ::=  1407  -- 낙하물/보행자 알림 해제 
   vehicle-traveling-wrong-way         ITISCodes-KOR ::=  1793 -- 역주행, 오류주행, 역주행차량 
   emergency-vehicles-on-roadway       ITISCodes-KOR ::=  1796 -- 긴급차량 접근 
   dangerous-vehicle-warning-cleared   ITISCodes-KOR ::=  1918 -- 역주행 해제 
   slow-vehicle                        ITISCodes-KOR ::=  2052 -- 서행, 저속차량 
   variable-message-signs-not-working  ITISCodes-KOR ::=  2308 -- VMS 동작 안 함, 갓길 주행 불가  
   variable-message-signs-operating    ITISCodes-KOR ::=  2310 -- VMS 운영, 갓길 주행 가능 
   bus-lane-available-for-all-vehicles ITISCodes-KOR ::=  2583  -- 버스전용차로 해제, 버스 주행 가능(전용차로 해제) 
   earthquake-damage                   ITISCodes-KOR ::=  3093 -- 지진 
   emergency-stopping-only             ITISCodes-KOR ::=  4119 -- 급정지 
   parking                             ITISCodes-KOR ::=  4120 -- 주차
   stopping                            ITISCodes-KOR ::=  4121 -- 급감속 
   heavy-snow                          ITISCodes-KOR ::=  4867 -- 강설, 눈, 대설 
   hail                                ITISCodes-KOR ::=  4880 -- 우박 
   heavy-rain                          ITISCodes-KOR ::=  4884 -- 강우, 비, 빗길 
   tropical-storm                      ITISCodes-KOR ::=  5124 -- 태풍 
   strong-winds                        ITISCodes-KOR ::=  5125 -- 강풍 
   dense-fog                           ITISCodes-KOR ::=  5377 -- 안개 
   air-quality-good                    ITISCodes-KOR ::=  5394 -- 공기질 좋음 
   air-quality-fair                    ITISCodes-KOR ::=  5395 -- 공기질 보통 
   air-quality-poor                    ITISCodes-KOR ::=  5396 -- 공기질 나쁨 
   air-quality-very-poor               ITISCodes-KOR ::=  5397 -- 공기질 매우 나쁨 
   surface-water-hazard                ITISCodes-KOR ::=  5893 -- 미끄러운 도로, 침수 
   wet-pavement                        ITISCodes-KOR ::=  5895 --  도로 습윤, 습윤 
   black-ice                           ITISCodes-KOR ::=  5908 -- 결빙, 도로 결빙 
   snow-on-roadway                     ITISCodes-KOR ::=  5916 -- 눈길, 도로 적설, 적설 
   increased-risk-of-accident          ITISCodes-KOR ::=  6922 --  사고다발지역 
   use-shoulder-as-lane                ITISCodes-KOR ::=  7436 -- 갓길 주행 가능 
   do-not-drive-on-the-shoulder        ITISCodes-KOR ::=  7437 -- 갓길 주행 불가  
   reduce-your-speed                   ITISCodes-KOR ::=  7443 --  속력 완충 
   u-turn                              ITISCodes-KOR ::=  7751 -- U턴 
   in-tunnels                          ITISCodes-KOR ::=  7983 -- 터널 
   service-area                        ITISCodes-KOR ::=  7984 -- 휴게소 
   shoulder                            ITISCodes-KOR ::=  8027 --  갓길 정지 
