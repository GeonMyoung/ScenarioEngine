  elevationOffset   VertOffset-B07		OPTIONAL,
  heading			CoarseHeading		OPTIONAL,
  ...
}


TrailerUnitDescriptionList ::= SEQUENCE (SIZE(1..8)) OF TrailerUnitDescription


TrailerUnitDescription ::= SEQUENCE {
  isDolly          IsDolly, 
