-- KOR
BasicSafetyMessage-KOR ::= SEQUENCE {
  adas                  SEQUENCE (SIZE(0..12)) OF CITSADAS-KOR  OPTIONAL,
  typeEvent             ITIScodes                               OPTIONAL,
  laneID                LaneID                                  OPTIONAL,
  roadSegmentRef        RoadSegmentReferenceID                  OPTIONAL,
  dectLane              DectLane-KOR                            OPTIONAL,
  verticalHeading       VerticalHeading-KOR                     OPTIONAL,
  brakePedalCmd         BrakePedalCmd-KOR                       OPTIONAL,
  brakePedalPressure    BrakePedalPressure-KOR                  OPTIONAL,
  eventFlags            VehicleEventFlags-KOR                   OPTIONAL,
  wheelAngle            WheelAngle-KOR                          OPTIONAL,
  responseType          ResponseType-KOR                        OPTIONAL,
  ...
}

CITSADAS-KOR ::= SEQUENCE {
  event             ADASEventType,
  distance          ObstacleDistance        OPTIONAL,         
  time              DSecond                 OPTIONAL,
  lon               Longitude               OPTIONAL,
  lat               Latitude                OPTIONAL,
  confidence        PositionConfidence      OPTIONAL,
  ...
}

EventDescription-KOR ::= SEQUENCE {
  eventType         ITISCodes-KOR
}

SupplementalVehicleExtensions-KOR ::= SEQUENCE {
   vehicleClass BasicVehicleClass-KOR,
   ...
}

VehicleClassification-KOR ::= SEQUENCE {
   role        BasicVehicleRole-KOR       OPTIONAL,
   ...
}

WheelAngle-KOR ::= SEQUENCE {
   flWheelAngle        DrivingWheelAngle     OPTIONAL,
   frWheelAngle        DrivingWheelAngle     OPTIONAL,
   rlWheelAngle        DrivingWheelAngle     OPTIONAL,
   rrWheelAngle        DrivingWheelAngle     OPTIONAL
}

BasicVehicleClass-KOR ::= ENUMERATED {
   unknown                             (0),
   passenger-vehicle-tiny              (1),
   passenger-vehicle-mini              (2),
   passenger-vehicle-small             (3),
   passenger-vehicle-medium            (4),
   passenger-vehicle-fullsize          (5),
   van-mini                            (6),
   van-small                           (7),
   van-medium                          (8),
   van-fullsize                        (9),
   truck-tiny                          (10),
   truck-mini                          (11),
   truck-small-A                       (12),
   truck-small-B                       (13),
   truck-medium-A                      (14),
   truck-medium-B                      (15),
   truck-medium-C                      (16),
   truck-fullsize-A                    (17),
   truck-fullsize-B                    (18),
   truck-fullsize-C                    (19),
   truck-fullsize-D                    (20),
   truck-fullsize-E                    (21),
   special-vehicle-mini                (22),
   special-vehicle-small               (23),
   special-vehicle-medium              (24),
   special-vehicle-fullsize            (25),
   motorcycle-mini                     (26),
   motorcycle-small                    (27),
   motorcycle-medium                   (28),
   motorcycle-fullsize                 (29),
   heavy-equipment                     (30),
   motorcycle-tiny                     (31),
   motorized-bicycle                   (32),
   personal-mobility-kickboard         (33),
   personal-mobility-segway            (34),
   personal-mobility-throttle-bicycle  (35),
   bicycle-general                     (36),
   bicycle-pas                         (37),
   horse-cattle                        (38),
   tram                                (39),
   pedestrian                          (40),
   etc
}

BasicVehicleRole-KOR ::= ENUMERATED {
   unknown                             (0),
   general-passenger-vehicle           (1),
   general-school-bus                  (2),
   general-bicycle                     (3),
   general-motorcycle                  (4),
   general-heavy-equipment             (5),
   general-vehicle-with-trailer        (6),
   general-pedestrian                  (7),
   general-personal-mobility           (8),
   general-farming-vehicle             (9),
   general-recreational-vehicle        (10),
   general-etc                         (11),
   general-unknown                     (12),
   emergency-police                    (13),
   emergency-fire                      (14),
   emergency-embulacne                 (15),
   emergency-hazmat                    (16),
   emergency-military                  (17),
   emergency-prosecutor                (18),
