   bus-lanes                           ITISCodes-KOR ::=  8220 -- 버스전용차로 시행 
   traffic                             ITISCodes-KOR ::=  9261 -- 교통 정보 
   pedestrians                         ITISCodes-KOR ::=  9486 -- 보행자 
   bicyclists                          ITISCodes-KOR ::=  9487 -- 자전거 
   county-police-units                 ITISCodes-KOR ::=  9732 -- 경찰차 
