message set definition
{
	include libdz1_support;
	include GitsnAsnUtilDef;

	typedef func void GitsnDSRCMsgTestScenarioException(void *exceptionArg, Dz1Error *reason);


	---------------------------------------------------
	typedef enum GitsnDSRCMsgProcessStatusCode
	{
		-- SUCCESS = 0
		OK = 0,

		-- MainScenario Failure
		FAILURE = 1,							-- 표준적합성 시험 실패

		-- SYSTEM ERROR (11 ~ 99)
		AGENT_SYSTEM_ERROR = 11,                 -- 검증 엔진 시스템 오류
		SERVER_DISCONNECTED = 12,                -- 서버와의 연결이 끊김
		TEST_CONFIGURATION_ERROR = 13,			-- 시험 환경 설정 오류

		-- NETWORK ERROR (100 ~ 199) 시험 대상과의 네트워크 오류
		CONNECTION_FAIL = 100,                  -- 시험 대상에게 접속 시도 실패
		DISCONNECTED = 101,                     -- 시험 대상과의 연결 끊김
		TIMEOUT = 102,                          -- 응답 시간 초과

		-- DATA CONFORM ERROR (200 ~ 299) 정보 연계 규격 검증 오류
		-- COMMON
		OUT_OF_RANGE = 201,                     -- 범위 초과
		INVALID_PROCESS,						-- 유효하지 않은 절차
		INVALID_IDENTIFIER,						-- 유효하지 않은 식별자
		SESSION_DUPLICATE,						-- 중복 로그인 
		LOGIN_AUTH_ERROR,						-- 로그인 인증 오류							
    
		-- ASN   
		DECODE_FAIL = 210,                      -- 디코딩 실패
		INVALID_ENCODING_RULE = 211,            -- 유효하지 않은 인코딩 규칙
		INVALID_OID = 212,                      -- 유효하지 않은 OID
		INVALID_DSRC_MSG_ID = 213,              -- 유효하지 않은 DSRC MSG ID
    
		-- JSON
		JSON_PARSE_ERROR = 221,                 -- JSON 파싱 실패

		-- PROTOBUF
		PROTOBUF_DESERAILIZE_ERROR = 231,       -- ProtoBuf 역직렬화 실패

		-- MESSAGE BROKER
		INVALID_TOPIC = 241,                    -- 유효하지 않은 TOPIC 이름

		 -- OPENAPI
        INVALID_REQUEST = 251,                  -- 유효하지 않은 요청

		-- UNKNOWN ERROR
		UNKNOWN = 300                           -- 알 수 없음
	
 	} GitsnDSRCMsgProcessStatusCode;		// with api dump, clone

	-- notify
	typedef struct GitsnDSRCMsgNotifyStateContext
	{
		TString								 testName;
		int64								 time;
		TString								 state;
	} GitsnDSRCMsgNotifyStateContext;							// with api dump, clone

	typedef struct GitsnDSRCMsgNotifyInfoContext
	{
		TString								 testName;
		int64								 time;
		TString								 sender;
		TString								 log;
		Dz1Binary							*data;
		TString								 dataType;
	} GitsnDSRCMsgNotifyInfoContext;							// with api dump, clone

	typedef struct GitsnDSRCMsgNotifyErrorContext
	{
		TString								 testName;
		int64								 time;
		GitsnDSRCMsgProcessStatusCode				 code;
		TString								 desc;
		TString								 log;
		Dz1Binary							*data;
	} GitsnDSRCMsgNotifyErrorContext;							// with api dump, clone

	-- NotifyArg
	typedef struct GitsnDSRCMsgNotifyStateArg
	{
		uint32								 testIdx;
		GitsnDSRCMsgNotifyStateContext				*context;
	} GitsnDSRCMsgNotifyStateArg;		// with api dump, clone

	typedef struct GitsnDSRCMsgNotifyInfoArg
	{
		uint32								 testIdx;
		GitsnDSRCMsgNotifyInfoContext				*context;
	} GitsnDSRCMsgNotifyInfoArg;		// with api dump, clone

	typedef struct GitsnDSRCMsgNotifyErrorArg
	{
		uint32								 testIdx;
		GitsnDSRCMsgNotifyErrorContext				*context;
	} GitsnDSRCMsgNotifyErrorArg;		// with api dump, clone

    typedef union GitsnDSRCMsgNotifyContext
    {
        GitsnDSRCMsgNotifyStateContext					*state;
		GitsnDSRCMsgNotifyInfoContext					*info;
		GitsnDSRCMsgNotifyErrorContext					*error;
    } GitsnDSRCMsgNotifyContext;            // with api dump, clone

	-- validate
	typedef struct GitsnDSRCMsgValidateContext
	{
		TString								 testName;
		int64								 time;
		Dz1Binary							*raw;
		Dz1Binary							*data;
		GitsnDSRCMsgProcessStatusCode				 code;
		TString								 desc;
	} GitsnDSRCMsgValidateContext;		// with api dump, clone

	typedef struct GitsnDSRCMsgValidateContextArg
	{
		uint32								 testIdx;
		GitsnDSRCMsgValidateContext				*context;
	} GitsnDSRCMsgValidateContextArg;			// with api dump, clone


	typedef struct GitsnDSRCMsgTestConfiguration
	{
		int64					 local_port;
		bool					 test_map;				-- 18
		bool					 test_spat;				-- 19
		bool					 test_bsm;				-- 20
		bool					 test_eva;				-- 22
		bool					 test_pvd;				-- 26
		bool					 test_rsa;				-- 27
		bool					 test_rtcm;				-- 28
		bool					 test_srm;				-- 28
		bool					 test_ssm;				-- 29
		bool					 test_tim;				-- 31
		bool					 test_psm;				-- 32
		bool					 test_sdsm;				-- 41
		bool					 test_tls;				-- 50
	} GitsnDSRCMsgTestConfiguration;		// with api dump, clone

}
