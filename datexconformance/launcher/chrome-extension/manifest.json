{
  "manifest_version": 3,
  "name": "DATEX 웹 시험 연결",
  "version": "3.0.0",
  "description": "간편실행기의 설정을 시험 웹 화면에 입력하고 실제 설정·시작 버튼을 연결합니다.",
  "key": "",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://106.250.189.37/static/test/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}