	----------------------------------------------------
	-- Clock Download
	----------------------------------------------------
	typedef enum ClockInfoWeekIndex
	{
		sun = 0,
		mon,
		tue,
		wed,
		thu,
		fri,
		sat
	} ClockInfoWeekIndex;

	typedef struct ClockInfo
	{
		-- Byte 1 ~ 6
		uint8					 year;
		uint8					 month;
		uint8					 day;
		uint8					 hour;
		uint8					 minute;
		uint8					 second;
		-- Byte 7
		ClockInfoWeekIndex		 week_index;
	} ClockInfo;					// with api dump, clone

	typedef struct ClockInformationDownload
	{
		uint8					 cross_id;
		ClockInfo				*clock_info_down;
	} ClockInformationDownload;		// with api dump, clone
