	----------------------------------------------------
	-- Special Command
	----------------------------------------------------
	
	typedef struct SpecialCommandPPCVehicleProperty
	{
		uint32					property;			
	} SpecialCommandPPCVehicleProperty;			// with api dump, clone
	typedef array SpecialCommandPPCVehicleProperties(extract, count, gethead) [SpecialCommandPPCVehicleProperty];

	typedef struct SpecialCommandInfoPPCControlManage
	{
		-- Byte 1
		-- bit 7 is reserved
		bool						 is_org_code_registered_vehicle_request;
		bool						 is_register_org_code;
		bool						 is_delete_org_code;
		bool						 is_register_vehicle_num;
		bool						 is_delete_vehicle_num;
		bool						 vehicle_code;
		-- bit 0 is reserved

		-- Byte 2
		uint8						 org_manage_code;
		
		-- Byte 3 ~ 6
		SpecialCommandPPCVehicleProperty	*vehicle_property;
	} SpecialCommandInfoPPCControlManage;	// with api dump, clone

	typedef struct SpecialCommandInfo
	{
		-- Byte 1
		bool						 is_shut_down;
		bool						 is_blink_control;
		bool						 is_lamp_light_control;
		bool						 is_confilct;
		bool						 is_manual;
		bool						 is_confilct_reset;
		bool						 is_scu_reset;
		bool						 is_mcu_reset;
		-- Byte 2
		bool						 is_ppc_control;
		bool						 is_pedestrian_button;
		bool						 is_x_control;
		bool						 is_spill_back_control;
		bool						 is_phase_omit;
		bool						 is_phase_hold;
		bool						 is_actuation_control;
		bool						 is_stagger_control;
		-- Byte 3 ~ 6
		uint8						 operation_flag;
		uint8						 hold_omit_phase;
		uint8						 stagger_plan;
		uint8						 spill_back_direction_code;
		-- Byte 7
		uint8						 sub_phase_spill_back;		-- 4 bit 0~15	(7..4)
		uint8						 main_phase_spill_back;		-- 4 bit 0~15	(3..0)

		-- Byte 8 ~ 13
		SpecialCommandInfoPPCControlManage	*ppc_control_manage;

	} SpecialCommandInfo;				// with api dump, clone

	typedef struct SpecialCommandInformation
	{
		uint8				 cross_id;
		SpecialCommandInfo	*special_command;
	} SpecialCommandInformation;		// with api dump, clone



	typedef struct SpecialCommandPPCNumberList_is_emergency
	{
		bool				 is_emergency;
	} SpecialCommandPPCNumberList_is_emergency;		// with api dump, clone

	typedef struct SpecialCommandPPCNumberList_org_code
	{
		uint8				 org_code;
	} SpecialCommandPPCNumberList_org_code;			// with api dump, clone

	typedef struct SpecialCommandPPCNumberList_org_code_num
	{
		uint8				 org_code_num;
	} SpecialCommandPPCNumberList_org_code_num;			// with api dump, clone
	
	typedef struct SpecialCommandPPCNumberList_org_code_type
	{
		uint32				 org_code_type;
	} SpecialCommandPPCNumberList_org_code_type;			// with api dump, clone


	typedef struct SpecialCommandPPCNumberList
	{
		-- Byte 1
		SpecialCommandPPCNumberList_is_emergency	*is_emergency;
		-- Byte 2				
		SpecialCommandPPCNumberList_org_code		*org_code;
		-- Byte 3
		SpecialCommandPPCNumberList_org_code_num	*org_code_num;
		-- Byte 4 ~ 7
		SpecialCommandPPCNumberList_org_code_type	*org_code_type;
		-- Byte 8 ~
		SpecialCommandPPCVehicleProperties	*vehicle_properties;
	} SpecialCommandPPCNumberList;		// with api dump, clone

	typedef struct SpecialCommandInformationResponse
	{
		uint8						 cross_id;
		SpecialCommandPPCNumberList	*ppc_register_num_list;		// is notarg -- OPTIONAL
	} SpecialCommandInformationResponse;		// with api dump, clone

