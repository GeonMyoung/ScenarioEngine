	----------------------------------------------------
	-- Firmware upgrade 
	----------------------------------------------------
	typedef struct FirmwareUpgradeData
	{
		-- Byte 1 ~ 2
		uint16					 fw_module_id;
		-- Byte 3 ~ 6
		uint32					 fw_module_size;
		-- Byte 7 ~ 21
		TString					 fname;
		-- Byte 22
		uint8					 major_version;
		-- Byte 23				 
		uint8					 minor_version;
		-- Byte 24			
		uint8					 module_version;
		-- Byte 25 ~ 26
		uint16					 revision_version;
		-- Byte 27
		bool					 is_forced_upgrade;
		-- Byte 28
		uint8					 reboot_option;
		-- Byte 29 ~ 32
		uint32					 crc32;
	} FirmwareUpgradeData;			// with api dump, clone

	typedef struct FirmwareUpgradeCommand
	{
		uint8					 cross_id;
		FirmwareUpgradeData		*fw_upgrade_data;
	} FirmwareUpgradeCommand;		// with api dump, clone

	typedef enum FirmwareUpgradeErrorCode
	{
		no_error,
		lower_version_than_current_module,
		mismatched_vender_code,
		crc_error,
		module_size_exceeds_the_initial_size,
		other
	} FirmwareUpgradeErrorCode;

	typedef struct FirmwareUpgradeError
	{
		FirmwareUpgradeErrorCode		code;
	}FirmwareUpgradeError;			// with api dump, clone
	typedef struct FirmwareUpgradeResponse
	{
		uint8					 cross_id;
		FirmwareUpgradeError	 *error;
	} FirmwareUpgradeResponse;		// with api dump, clone
	----------------------------------------------------
	-- Firmware upgrade 
	----------------------------------------------------

	----------------------------------------------------
	-- Traffic Signal Controller Test Request list
	----------------------------------------------------
	typedef union TrafficSignalControllerRequest
	{
		CrossControlInformation					[0x10]	*control;
		CrossIndicator							[0x12]	*status;
		-- CrossStatusRequest						[0x12]	*status;
		CrossIndicator							[0x22]	*detector;
		SignalPhaseInformationDownload			[0x30]	*signal_phase_down;
		CrossIndicator							[0x32]	*signal_phase_up;
		ClockInformationDownload				[0x40]	*clock_down;
		CrossIndicator							[0x42]	*clock_up;
		SpecialCommandInformation				[0x50]	*special_cmd;
		FirmwareUpgradeCommand					[0x56]	*fw_upgrade_cmd;
	} TrafficSignalControllerRequest;				// with api dump, clone

	typedef union TrafficSignalControllerResponse
	{
		CrossIndicator							[0x11]	*control;
		CrossStatusInformation					[0x13]	*status;
		DetectorInformation						[0x23]	*detector;
		CrossIndicator							[0x31]	*signal_phase_down;
		SignalPhaseInformationUpload			[0x33]	*signal_phase_up;
		CrossIndicator							[0x41]	*clock_down;
		ClockInformationUpload					[0x43]	*clock_up;
		SpecialCommandInformationResponse		[0x51]	*special_cmd;
		FirmwareUpgradeResponse					[0x57]	*fw_upgrade_cmd;
	} TrafficSignalControllerResponse;				// with api dump, clone

