message set definition
{
	include libdz1_support;

	----------------------------------------------------
	-- 교차로제어정보
	----------------------------------------------------
	typedef enum CrossControlRingRcCmd
	{
		none,
		EndPhase1,
		EndPhase2,
		EndPhase3,
		EndPhase4,
		EndPhase5,
		EndPhase6,
		EndPhase7,
		EndPhase8
	} CrossControlRingRcCmd;

	typedef struct CrossControlRingRcDualCmd
	{
		CrossControlRingRcCmd			 ring_b;
		CrossControlRingRcCmd			 ring_a;
	} CrossControlRingRcDualCmd;				// with api dump, clone

	typedef enum CrossControlRingLcCmd
	{
		none,
		SetPhase1,
		SetPhase2,
		SetPhase3,
		SetPhase4,
		SetPhase5,
		SetPhase6,
		SetPhase7,
		SetPhase8,
		SetPhaseNext
	} CrossControlRingLcCmd;

	typedef struct CrossControlRingLcDualCmd
	{
		CrossControlRingLcCmd			 ring_b;
		CrossControlRingLcCmd			 ring_a;
	} CrossControlRingLcDualCmd;				// with api dump, clone

	typedef union CrossControlSingleCmd
	{
		CrossControlRingLcCmd	[0x00]	 lc_fixed;
		CrossControlRingLcCmd	[0x10]	 lc_control;
		CrossControlRingLcCmd	[0x12]	 lc_actuation;

		CrossControlRingRcCmd	[0x14]	 rc_actuation;
		CrossControlRingRcCmd	[0x16]	 rc_online;
	} CrossControlSingleCmd;				// with api dump, clone

	typedef union CrossControlDualCmd
	{
		CrossControlRingLcDualCmd		[0x00]	 *lc_fixed;
		CrossControlRingLcDualCmd		[0x10]	 *lc_control;
		CrossControlRingLcDualCmd		[0x12]	 *lc_actuation;

		CrossControlRingRcDualCmd		[0x14]	 *rc_actuation;
		CrossControlRingRcDualCmd		[0x16]	 *rc_online;
	} CrossControlDualCmd;				// with api dump, clone

	typedef union CrossControlCmd
	{
		CrossControlSingleCmd	[0] *single;		
		CrossControlDualCmd		[1] *dual;
	} CrossControlCmd;					// with api dump, clone

	typedef struct CrossControlInformation
	{
		uint8								 cross_id;
		CrossControlCmd						*command;
	} CrossControlInformation;					// with api dump, clone
	----------------------------------------------------
	-- 교차로제어정보
	----------------------------------------------------

	typedef struct CrossIndicator
	{
		uint8						 cross_id;
	} CrossIndicator;					// with api dump, clone

	----------------------------------------------------
	-- 교차로상황정보
	----------------------------------------------------
	typedef enum CrossStatusBasicInfo_OperationMode
	{
		fixed,
		lc,
		lc_actuator,
		rc_actuator = 4,
		rc
	} CrossStatusBasicInfo_OperationMode;					

	typedef enum CrossStatusBasicInfo_BlinkReason
	{
		unknown,
		power_on,
		config,
		switched,
		contradiction,
		db_error,
		lights_off,
		sys_fault
	} CrossStatusBasicInfo_BlinkReason;

	typedef struct CrossStatusBasicInfo
	{
		-- Byte 1
		bool						 power_fail;
		bool						 comm_fail;	
		bool						 lamp_oper;
		bool						 is_dual_ring;
		bool						 ppc_enabled;
		CrossStatusBasicInfo_OperationMode	 oper_mode;			-- 3 bit
		-- Byte 2
		uint8						 ring_a_phase;		-- 3 bit = 0 ~ 7
		uint8						 ring_a_step;		-- 5 bit = 0 ~ 31
		-- Byte 3
		uint8						 ring_b_phase;		-- 3 bit = 0 ~ 7
		uint8						 ring_b_step;		-- 5 bit = 0 ~ 31
		-- Byte 4
		bool						 pannel_is_manual;
		bool						 pannel_manual_sw;
		bool						 pannel_blink_sw;
		bool						 pannel_light_out_sw;
		bool						 is_contradiction;
		bool						 is_light_out;
		bool						 is_blink;
		bool						 is_database;
		-- Byte 5
		bool						 push_button_enable;
		CrossStatusBasicInfo_BlinkReason			 blink_reason;			-- 3 bit = 0 ~ 7
		bool						 is_timed_left_signal;
		bool						 manual_enabled;
		bool						 conflict_enabled;
		bool						 is_door_opened;
		-- Byte 6
		uint8						 contradiction_lsu;		-- 4 bit
		bool						 contradiction_from_sw;
		uint8						 contradiction_curcuit;	-- 3 bit
		-- Byte 7~9
		uint8						 pedestrian_lamp;		-- 8 bit direction flag
		uint8						 push_button_pending;
		uint8						 push_button_status;
		-- Byte 10~16
		uint8						 opt_board_status;
		uint8						 period_counter;
		uint8						 total_period;
		uint8						 curr_period;
		uint8						 period_offset;
		uint8						 hold_phase;
		uint8						 omit_phase;
		-- Byte 17
		bool						 is_four_color_lamp;
		uint8						 oper_map_id;		-- 3 bit = 0 ~ 7
		bool						 jam_ctrl_enabled;
		bool						 jam_ctrl_mode;
		bool						 jam_term_early0;
		bool						 jam_term_early1;
	-- Byte 18~19, 20~21
		uint16						 firmware_id;
		uint16						 firmware_idx;
	-- Byte 22
		uint8						 database_status;
	-- Byte 23-24
		uint8						 ppc_control_status;
		uint8						 ups_control_status;
	-- Byte 25
		bool						 map_is_dirty;				-- bit 0
		bool						 lock_installed;			-- bit 1
		bool						 lock_is_locked;			-- bit 2
		bool						 db_is_locked;				-- bit 3
	} CrossStatusBasicInfo;					// with api dump, clone

	typedef enum CrossStatusExtInfo_ContradictionReason
	{
		none,
		voltage,
		current,
		map
	} CrossStatusExtInfo_ContradictionReason;

	typedef struct CrossStatusExtInfo_r27
	{
		uint8									 type;						-- Byte 1
		uint8									 ver;						-- Byte 2
		Dz1Binary								*ppc_data;					-- Byte 3~18	16 Byte
		uint32									 detector_status;			-- Byte 19~22	32 bit flags
		uint8									 mlc_slc_comm_fail;			-- Byte 23		4 bit / 4 bit
		uint8									 contradiction_slc;			-- Byte 24
		-- Byte 25
		CrossStatusExtInfo_ContradictionReason	 contradiction_prove;		--				3 bit
		uint8									 contradiction_circuit;		--				5 bit = 0 ~ 31(value = 1 ~ 14)

		uint8									 ring_a_phase;				-- Byte 26
		uint8									 ring_a_step;				-- Byte 27
		uint8									 ring_b_phase;				-- Byte 28
		uint8									 ring_b_step;				-- Byte 29
																			-- Byte 30~50	Padding 21 Byte				
	} CrossStatusExtInfo_r27;					// with api dump, clone
	
	typedef struct CrossStatusExtInfo_r29
	{
		uint8									 type;						-- Byte 1
		uint8									 ver;						-- Byte 2
		Dz1Binary								*ppc_data;					-- Byte 3~18	16 Byte
		uint32									 detector_status;			-- Byte 19~22	32 bit flags
		uint8									 mlc_slc_comm_fail;			-- Byte 23		4 bit / 4 bit
		uint8									 contradiction_slc;			-- Byte 24
		-- Byte 25
		CrossStatusExtInfo_ContradictionReason	 contradiction_prove;		--				3 bit
		uint8									 contradiction_circuit;		--				5 bit = 0 ~ 31(value = 1 ~ 14)

		uint8									 ring_a_phase;				-- Byte 26
		uint8									 ring_a_step;				-- Byte 27
		uint8									 ring_b_phase;				-- Byte 28
		uint8									 ring_b_step;				-- Byte 29
																			-- Byte 30~50	Padding 21 Byte
																			

		uint16									 period_cnt;				-- Byte 30~31
		uint16									 last_period_len;			-- Byte 32~33
		uint16									 current_period;			-- Byte 34~35
		uint16									 offset;					-- Byte 36~50	Padding	15 Byte
	} CrossStatusExtInfo_r29;					// with api dump, clone


	typedef struct CrossStatusInformation
	{
		uint8								 cross_id;
		CrossStatusBasicInfo				*lc_status;
		CrossStatusExtInfo_r27				*ex_status;				// is notarg -- optional
	} CrossStatusInformation;						// with api dump, clone			


