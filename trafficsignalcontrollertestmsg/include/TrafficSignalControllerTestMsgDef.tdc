	typedef struct SignalPhaseInfoPeriodicOperationTime
	{
		-- Byte 1 ~ 8
		uint8					 ring_a_phase1;
		uint8					 ring_a_phase2;
		uint8					 ring_a_phase3;
		uint8					 ring_a_phase4;
		uint8					 ring_a_phase5;
		uint8					 ring_a_phase6;
		uint8					 ring_a_phase7;
		uint8					 ring_a_phase8;

		-- Byte 9 ~ 16
		uint8					 ring_b_phase1;
		uint8					 ring_b_phase2;
		uint8					 ring_b_phase3;
		uint8					 ring_b_phase4;
		uint8					 ring_b_phase5;
		uint8					 ring_b_phase6;
		uint8					 ring_b_phase7;
		uint8					 ring_b_phase8;
	} SignalPhaseInfoPeriodicOperationTime;					// with api dump, clone

	typedef struct SignalPhaseInfoDownBasic
	{
		-- Byte 1 ~ 16
		SignalPhaseInfoPeriodicOperationTime			*periodic_oper_time1;
		-- Byte 17
		uint8					 offset;
	}SignalPhaseInfoDownBasic;		// with api dump, clone

	typedef struct SignalPhaseInfoDown_r27
	{
		-- Byte 1 ~ 17
		SignalPhaseInfoDownBasic						*mandatory;

		-- Byte 18 ~ 33
		SignalPhaseInfoPeriodicOperationTime			*periodic_oper_time2;		// is notarg -- optional

		-- Byte 34 ~ 49
		SignalPhaseInfoPeriodicOperationTime			*periodic_oper_time3;		// is notarg -- optional
	} SignalPhaseInfoDown_r27;				// with api dump, clone

	typedef struct SignalPhaseInfoDown_r29
	{
		-- Byte 1 ~ 17
		SignalPhaseInfoDownBasic						*mandatory;

		-- Byte 18 ~ 33
		SignalPhaseInfoPeriodicOperationTime			*periodic_oper_time2;		// is notarg -- optional

		-- Byte 34 ~ 49
		SignalPhaseInfoPeriodicOperationTime			*periodic_oper_time3;		// is notarg -- optional

		-- Byte 50-51
		uint16											 offset1;
		uint16											 offset2;					// is notarg -- optional
		uint16											 offset3;					// is notarg -- optional
	} SignalPhaseInfoDown_r29;				// with api dump, clone


	typedef struct SignalPhaseInformationDownload
	{
		uint8									 cross_id;
		SignalPhaseInfoDown_r27					*signal_phase_info_down;
	} SignalPhaseInformationDownload;		// with api dump, clone
