		uint8										 ppc_priority_signal;			// is notarg -- optional
	} SignalPhaseInfoUpPPCControl;				// with api dump, clone
	 
	typedef struct SignalPhaseInfoUp
	{
		-- Byte 1 ~ 16
		SignalPhaseInfoPeriodicOperationTime		*operation_time;
		-- Byte 17 ~ 32
		SignalPhaseInfoPeriodicOperationTime		*pedestrianoperation_time;		// is notarg -- optional
		-- 33 ~ 35
		SignalPhaseInfoUpPPCControl					*ppc_control;					// is notarg -- optional
	} SignalPhaseInfoUp;			// with api dump, clone
		
	typedef struct SignalPhaseInformationUpload
	{
		uint8							 cross_id;
		SignalPhaseInfoUp				*signal_phase_info_up;
	} SignalPhaseInformationUpload;			// with api dump, clone

