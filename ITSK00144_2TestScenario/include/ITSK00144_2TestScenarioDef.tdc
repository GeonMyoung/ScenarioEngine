message set definition
{
	include libdz1_support;
	include ITSK00144_2TestMsgDef;
	include GitsnAsnUtilDef;
	
	typedef func void ITSK001442TestScenarioException(void *exceptionArg, Dz1Error *reason);
	
	typedef enum ITSK00144_2ProcessStatusCode
	{
		-- SUCCESS = 0
		OK = 0,

		-- MainScenario Failure
		FAILURE = 1,							-- 표준적합성 시험 실패

		-- SYSTEM ERROR (11 ~ 99)
		AGENT_SYSTEM_ERROR = 11,                 -- 검증 엔진 시스템 오류
		SERVER_DISCONNECTED = 12,                -- 서버와의 연결이 끊김
		TEST_CONFIGURATION_ERROR = 13,			-- 시험 환경 설정 오류

		-- NETWORK ERROR (100 ~ 199) 시험 대상과의 네트워크 오류
		CONNECTION_FAIL = 100,                  -- 시험 대상에게 접속 시도 실패
		DISCONNECTED = 101,                     -- 시험 대상과의 연결 끊김
		TIMEOUT = 102,                          -- 응답 시간 초과

		-- DATA CONFORM ERROR (200 ~ 299) 정보 연계 규격 검증 오류
		-- COMMON
		OUT_OF_RANGE = 201,                     -- 범위 초과
		INVALID_PROCESS,						-- 유효하지 않은 절차
		INVALID_IDENTIFIER,						-- 유효하지 않은 식별자
		SESSION_DUPLICATE,						-- 중복 로그인 
		LOGIN_AUTH_ERROR,						-- 로그인 인증 오류							
    
		-- ASN   
		DECODE_FAIL = 210,                      -- 디코딩 실패
		INVALID_ENCODING_RULE = 211,            -- 유효하지 않은 인코딩 규칙
		INVALID_OID = 212,                      -- 유효하지 않은 OID
		INVALID_DSRC_MSG_ID = 213,              -- 유효하지 않은 DSRC MSG ID
    
		-- JSON
		JSON_PARSE_ERROR = 221,                 -- JSON 파싱 실패

		-- PROTOBUF
		PROTOBUF_DESERAILIZE_ERROR = 231,       -- ProtoBuf 역직렬화 실패

		-- MESSAGE BROKER
		INVALID_TOPIC = 241,                    -- 유효하지 않은 TOPIC 이름

		 -- OPENAPI
        INVALID_REQUEST = 251,                  -- 유효하지 않은 요청

		-- UNKNOWN ERROR
		UNKNOWN = 300                           -- 알 수 없음
	
 	} ITSK00144_2ProcessStatusCode;		// with api dump, clone

	-- notify
