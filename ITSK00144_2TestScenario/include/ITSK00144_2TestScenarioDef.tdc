	typedef struct ITSK00144_2TestConfiguration_LinkUnitRole
	{
		TString							 peer_ip;
		uint64							 peer_port;
		uint32							 serial_no;

		bool							 test_req_link_unit_status;
		bool							 test_req_status;
		bool							 test_req_list;
		bool							 test_req_update_list;
		bool							 test_req_reset;
		bool							 test_session_maintain;
		int64							 hb_duration;
		bool							 test_tim;
		bool							 test_map;

	} ITSK00144_2TestConfiguration_LinkUnitRole;		// with api dump, clone

	typedef union ITSK00144_2TestConfiguration
	{
		ITSK00144_2TestConfiguration_ServerRole		*serverRole;
		ITSK00144_2TestConfiguration_LinkUnitRole	*linkUnitRole;
	} ITSK00144_2TestConfiguration;						// with api dump, clone
