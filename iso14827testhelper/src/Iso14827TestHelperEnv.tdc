	-------------------------------------------------------------------------------
	-- DUO SESSION Mode State
	-------------------------------------------------------------------------------
	typedef enum Iso14827TestDuoSessionServerState
	{
		initial,
		wait_auth,
		wait_connected,
		established,
		idle,
		wait_logout,
		complete
	} Iso14827TestDuoSessionServerState;
	
	typedef enum Iso14827TestDuoSessionClientState
	{
		initial,
		wait_initiate,
		wait_heartbeat,
		wait_pub_data,
		idle,
		wait_disconnect,
		complete
	} Iso14827TestDuoSessionClientState;
