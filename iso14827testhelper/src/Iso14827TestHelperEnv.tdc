	-- DUO SESSION Mode Event
	-------------------------------------------------------------------------------

	-------------------------------------------------------------------------------
	-- Subscribe Entry & List
	-------------------------------------------------------------------------------
	typedef enum Iso14827TestSubType
	{
		single,
		event_driven,
		periodic
	} Iso14827TestSubType;

	typedef struct Iso14827TestSubEntry
	{
		Dz1Asn1UTF8Str								*peer;					// is key
		uint32										 sid;					// is key
		TString										 oid;
		Iso14827TestSubType					 type;
		uint32										 cnt;					// is notarg
	} Iso14827TestSubEntry;			// with api dump, clone, compare
	typedef unique table Iso14827TestSubList(find, extract, count, gethead) [Iso14827TestSubEntry];

	-------------------------------------------------------------------------------
	-- Task Envrioment
	-------------------------------------------------------------------------------
	typedef struct Iso14827TestHelperEnv
	{
		void										*tSelf;					// is nodump
		void										*t14827;				// is ref, nodump
		void										*tMain;					
		Dz1JsonSpec									*spec;
				
		Iso14827TestScenario						*scenario;				// is notarg

		bool										 is_run;				// is notarg

		-- Dz1TdqDbScheme							*dbh;					// is nodump
		
		int32										 state;					// is notarg
		uint32										 flags;					// is notarg

		Dz1Asn1Codec								 selected_codec;		// is notarg			--	Server1		Server2		Client		Duo-Server
		Dz1Asn1Codec								 selected_codec_duo;	// is notarg			--	Server1		Server2					Duo-Client
		Dz1Asn1OctetStr								*user;					// is notarg			--							Client
		Dz1SockAddr									*server_addr;			// is notarg			--							Client
		Iso14827TestClientAccount					*primary_acc;			// is notarg, ref		--							Client
		Iso14827TestClientAccount					*secondary_acc;			// is notarg, ref		--							Client
		SubscribeSpecList							*test_subs;										--							Client
		SubscribeSpecList							*test_subs2;			// is notarg							--							Client
		uint32										 test_subs_id;			// is notarg			--							Client		Duo-Client
		Iso14827TestSubList							*subs_reg;										--	Server1		Server2		Client		Duo-Server
		Iso14827TestSubList							*subs_reg2;										--							Client		
		Iso14827TestDataCheckList					*check_list;			// is notarg
		TString										 current_test;			// is notarg
		uint32										 testIdx;				// is notarg
		uint64										 hb_cnt;				// is notarg
	} Iso14827TestHelperEnv;				// with api dump
}
