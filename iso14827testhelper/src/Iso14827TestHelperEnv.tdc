	-------------------------------------------------------------------------------

	-------------------------------------------------------------------------------
	-- CLIENT Mode Event
	-------------------------------------------------------------------------------
	typedef enum Iso14827TestClientEvent
	{
		start,
		trigger,
		validate,

		initiated				= 200,
		echo,
		data,
		data_ctrl,
		terminate,
		disconnected,
		sub_received,

		timeout					= 1000
	} Iso14827TestClientEvent;
	-------------------------------------------------------------------------------
	-- CLIENT Mode Event
	-------------------------------------------------------------------------------

	-------------------------------------------------------------------------------
	-- SERVER Mode Event
	-------------------------------------------------------------------------------
	typedef enum Iso14827TestServerEvent
	{
		start,
		validate,

		auth					= 100,	
		connected,
		heartbeat,
		req_single,
		req_event_driven,
		req_periodic,
		data_start,
		data_period,
		data_stop,
		pubdata_rejected,
		req_expired,
		logout,
		pub_received,

		timeout					= 1000
	} Iso14827TestServerEvent;

	-------------------------------------------------------------------------------
	-- SERVER Mode Event
	-------------------------------------------------------------------------------

	-------------------------------------------------------------------------------
	-- DUO SESSION Mode Event
	-------------------------------------------------------------------------------
	typedef enum Iso14827TestDuoSessionEvent
	{
		start,
		trigger,

		auth			= 100,
		connected,
		heartbeat,
		req_single,
		req_event_driven,
		req_periodic,
		data_start,
		data_period,
		data_stop,
		pubdata_rejected,
		req_expired,
		logout,
		pub_received,

		initiated		= 200,
		echo,
		data,
		data_ctrl,
		terminate,
		disconnected,
		sub_received,

		timeout			= 1000
	} Iso14827TestDuoSessionEvent;
