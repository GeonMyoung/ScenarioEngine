message set definition
{
	include Dz1JsonDef;
	include Iso14827TestHelperDef;
	-- include Iso14827TestMsgDef;

	typedef struct Prj2TxDataCheckList
	{
		bool				 test_map;
		bool				 test_spat;
		bool				 test_sdsm;
	} Prj2TxDataCheckList;		// with api dump, clone

	typedef struct Prj2RxDataCheckList
	{
		bool				 test_pvd;
	} Prj2RxDataCheckList;		// with api dump, clone

	typedef union Iso14827TestDataCheckList
	{
		Prj2TxDataCheckList		*prj2_tx;
		Prj2RxDataCheckList		*prj2_rx;
	} Iso14827TestDataCheckList;		// with api dump, clone

	typedef struct Iso14827TestScenarioSetup		
	{
		Iso14827TestScenario				*scenario;
	} Iso14827TestScenarioSetup;			// with api dump, clone

	-------------------------------------------------------------------------------
	-- CLIENT Mode 1 State
	-------------------------------------------------------------------------------
	typedef enum Iso14827TestClient1State
	{
		initial,
		wait_initiate,			-- 비정상 로그인 및 로그인 시험
		wait_login_dup,			-- 중복 로그인 시험
		wait_disconnect,		-- 세션 유지 시험
		wait_restart,			-- 세션 유지시험으로 끊긴 연결 복구
		wait_invalid_subs,		-- 비정상 n종 서브스크립션 시험
		wait_normal_subs,		-- 정상 10종 서브스크립션 시험
		wait_subs_cancel,		-- 서브스크립션 명시적 취소
		wait_deferred_ack,		-- 퍼블리케이션 재전송 시험(임의 1종)
		wait_terminate,
		complete
	} Iso14827TestClient1State;
	-------------------------------------------------------------------------------
	-- CLIENT Mode 1 State
	-------------------------------------------------------------------------------
	
	-------------------------------------------------------------------------------
	-- CLIENT Mode 2 State
	-------------------------------------------------------------------------------
	typedef enum Iso14827TestClient2State
	{
		initial,
		connected,				-- 접속 완료, hb 대기
		wait_total_test,		-- 통합 정보 제공 시험
		wait_terminate,			-- 본 세션 연결해제
		complete
	} Iso14827TestClient2State;
	-------------------------------------------------------------------------------
	-- DUO CLIENT Mode State
	-------------------------------------------------------------------------------
	typedef enum Iso14827TestDuoClientState
	{
		initial,
		wait_duo_client1_established,
		wait_duo_subs_test,		-- 다중세션 - (서로다른 임의 1종) 정보제공 시험
		wait_duo_terminate,		-- 다중세션 - 연결 해제complete
		wait_terminate,			-- 본 세션 연결해제
		complete
	} Iso14827TestDuoClientState;
	-------------------------------------------------------------------------------
	-- DUO CLIENT Mode State
	-------------------------------------------------------------------------------
	-------------------------------------------------------------------------------
	-- SERVER Mode 1 State
	-------------------------------------------------------------------------------
	typedef enum Iso14827TestServer1State
	{
		initial,
		wait_auth,
		wait_connected,
		established,
		wait_violated_pub,
		wait_disconnect,
		complete
	} Iso14827TestServer1State;
	-------------------------------------------------------------------------------
	-- SERVER Mode 1 State
	-------------------------------------------------------------------------------
	-------------------------------------------------------------------------------
	-- SERVER Mode 2 State
	-------------------------------------------------------------------------------
	typedef enum Iso14827TestServer2State
	{
		initial,
		wait_auth,
		wait_connected,
		established,
		wait_timeout,
		wait_logout,
		complete
	} Iso14827TestServer2State;
	-------------------------------------------------------------------------------
