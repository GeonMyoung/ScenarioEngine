		ItsIso14827ClientDomainViolatedSubscription *violatedSub;
		uint32								 ctrl_flags;		// is notarg
	} ItsIso14827ClientDomainServerEntry;						// with api dump, compare
	
	typedef unique table ItsIso14827ClientDomainServerList(find, extract, count) [ItsIso14827ClientDomainServerEntry];
	
	------------------------------------------------------------------------------
