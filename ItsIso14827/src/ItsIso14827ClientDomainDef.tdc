	typedef unique table ItsIso14827ClientDomainSessionList(find, extract, count) [&ItsIso14827ClientDomainSessionEntry];
	------------------------------------------------------------------------------
	-- Client Domain
	------------------------------------------------------------------------------
	-- subscription 전송 시 응답이 올때 까지 Client는 Blocking되어야 한다.
	typedef struct ItsIso14827ClientDomain
	{
		Dz1Asn1UTF8Str						*name;				// is key
