message set definition
{
	include ItsIso14827DefLocal;

	-----------------------------------------------------------------------------
	-- Create Server
	-----------------------------------------------------------------------------
	typedef struct ItsIso14827DomainCreateServer
	{
		Dz1Asn1UTF8Str					*name;
		uint32							 maxClient;
		ItsIso14827CodecOIDMapList		*codecOIDMap;
		ItsIso14827ServerDomainCallback	*cbs;
	} ItsIso14827DomainCreateServer;							// with api dump

