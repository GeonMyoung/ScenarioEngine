	} TrafficSignalControllerNotifyInfoContext;							// with api dump, clone

	typedef struct TrafficSignalControllerNotifyErrorContext
	{
		TString								 testName;
		int64								 time;
		TrafficSignalControllerProcessStatusCode				 code;
		TString								 desc;
		TString								 log;
		Dz1Binary							*data;
	} TrafficSignalControllerNotifyErrorContext;							// with api dump, clone

