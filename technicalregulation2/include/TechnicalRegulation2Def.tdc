		uint8								priority;
		uint8								channel;
		uint16								txInterval;
		TString								ipAddress;					// is notarg
		uint16								servicePort;				// is notarg
		TString								provideServiceContext;		// is notarg
		time								deliveryStart;
		time								deliveryStop;
		bool								signature;					// is notarg
		int64								payloadType;				// is notarg
		Dz1Binary						   *payload;
		int8								txPower;					// is notarg
		uint8								txDataRate;					// is notarg					
		bool								channelNumberHdrExt;		// is notarg
		bool								dataRateHdrExt;				// is notarg
		bool								txPowerHdrExt;				// is notarg
	} CommTxPDUEntry;									// with api dump, clone, compare
	typedef unique table CommTxPDUList(find, extract, count, gethead) [CommTxPDUEntry];
	
