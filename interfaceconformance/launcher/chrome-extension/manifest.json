{
  "manifest_version": 3,
  "name": "표준적합성시험 웹 연결",
  "version": "2.0.0",
  "description": "DATEX·REST API·TCP/Binary·Kafka 간편 실행기를 시험 회차별로 연결합니다. 여러 창의 설정·시작·종료를 각각 처리합니다.",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://106.250.189.37/static/test/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "key": ""
}